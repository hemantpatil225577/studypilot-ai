# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Used ONLY for quiz answer keys and attempt writes. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Public site URL (used in email confirmation links) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI provider (server only) ---
# AI_PROVIDER: "anthropic" or "openai" (any OpenAI-compatible API works via AI_BASE_URL)
AI_PROVIDER=anthropic
AI_API_KEY=your-llm-api-key
# Set to a model name your key can use (for example a current Claude model, or gpt-4o-mini).
AI_MODEL=
# Optional override, e.g. https://api.openai.com or an OpenAI-compatible gateway
AI_BASE_URL=
# Per-user limit for expensive AI calls per hour
AI_RATE_LIMIT_PER_HOUR=30
